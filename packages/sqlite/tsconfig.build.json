{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "tsBuildInfoFile": "../../.cache/sqlite.tsbuildinfo",
    "types": ["node"]
  },
  "references": [
    { "path": "../core/tsconfig.build.json" },
    { "path": "../sqlite-common/tsconfig.build.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/fixtures/**"]
}
