{
  "name": "walq-workspace",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b packages/core/tsconfig.build.json packages/better-sqlite3/tsconfig.build.json",
    "clean": "tsc -b --clean packages/core/tsconfig.build.json packages/better-sqlite3/tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config oxlint.config.ts",
    "format": "oxfmt --config oxfmt.config.ts --write .",
    "format:check": "oxfmt --config oxfmt.config.ts --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "pack:check": "node scripts/check-packages.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm pack:check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "bench": "vitest bench --run --reporter=./benchmarks/vitest-reporter.ts",
    "bench:full": "BENCH_GRID=full pnpm bench",
    "bench:help": "vitest bench --help"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@changesets/cli": "^2.29.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.3",
    "@walq/better-sqlite3": "workspace:*",
    "@walq/core": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "publint": "^0.3.16",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.3.4"
}
